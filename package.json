{
  "name": "shark-translate",
  "displayName": "SharkTranslate",
  "description": "中文转shark",
  "version": "0.0.12",
  "publisher": "zs-liu",
  "engines": {
    "vscode": "^1.78.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:sharkTranslate.oneSharkReplace",
    "onCommand:sharkTranslate.allSharkReplace",
    "onCommand:sharkTranslate.exportChineseByPage",
    "onCommand:sharkTranslate.exportChineseByPageId",
    "onCommand:sharkTranslate.translateSelectionToExcel",
    "onCommand:sharkTranslate.batchTranslateChineseToExcel"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sharkTranslate.oneSharkReplace",
        "title": "Trip Shark点替"
      },
      {
        "command": "sharkTranslate.allSharkReplace",
        "title": "Trip Shark全替"
      },
      {
        "command": "sharkTranslate.exportChineseByPageId",
        "title": "Trip Shark中文全域巡检(默认扫描src目录)"
      },
      {
        "command": "sharkTranslate.exportChineseByPage",
        "title": "Trip Shark中文定域巡检"
      },
      {
        "command": "sharkTranslate.translateSelectionToExcel",
        "title": "Trip Shark闪译(单条)"
      },
      {
        "command": "sharkTranslate.batchTranslateChineseToExcel",
        "title": "Trip Shark批译(批量)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "sharkTranslate.translateSelectionToExcel",
          "title": "Trip Shark闪译(单条)",
          "group": "navigation",
          "when": "editorTextFocus && editorHasSelection && !editorReadonly"
        },
        {
          "command": "sharkTranslate.oneSharkReplace",
          "title": "Trip Shark点替",
          "group": "navigation",
          "when": "editorTextFocus && !editorReadonly"
        },
        {
          "command": "sharkTranslate.allSharkReplace",
          "title": "Trip Shark全替",
          "group": "navigation",
          "when": "editorTextFocus && !editorReadonly"
        }
      ],
      "explorer/context": [
        {
          "command": "sharkTranslate.batchTranslateChineseToExcel",
          "title": "Trip Shark批译(批量)",
          "group": "navigation@1"
        },
        {
          "command": "sharkTranslate.exportChineseByPageId",
          "title": "Trip Shrak中文全域巡检(默认扫描src目录)",
          "group": "navigation@2"
        },
        {
          "command": "sharkTranslate.exportChineseByPage",
          "title": "Trip Shark中文定域巡检",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "SharkTranslate",
      "properties": {
        "sharkTranslate.sharkStoreVar": {
          "type": "string",
          "default": "language",
          "description": "shark存储变量名"
        },
        "sharkTranslate.sharkPrefix": {
          "type": "array",
          "default": [],
          "description": "配置页面shark前缀，用于替换时快捷去除通用前缀"
        },
        "sharkTranslate.scanSrcPath": {
          "type": "string",
          "default": "src",
          "description": "扫描中文的源目录路径，相对于项目根目录，默认为 src"
        },
        "sharkTranslate.scanExcludePatterns": {
          "type": "array",
          "default": [],
          "description": "扫描时排除的文件或文件夹（glob 模式），例如: [\"**/components/**\", \"**/utils/helper.ts\"]（仅对 exportChineseByPageId 命令生效）"
        },
        "sharkTranslate.realtimeTranslateApiUrl": {
          "type": "string",
          "default": "https://api.openai.com/v1/chat/completions",
          "description": "实时翻译接口地址（OpenAI兼容）"
        },
        "sharkTranslate.realtimeTranslateApiKey": {
          "type": "string",
          "default": "",
          "description": "实时翻译接口密钥（Bearer Token）"
        },
        "sharkTranslate.realtimeTranslateModel": {
          "type": "string",
          "default": "gpt-4o-mini",
          "description": "实时翻译模型名称"
        },
        "sharkTranslate.realtimeTranslateExcelFile": {
          "type": "string",
          "default": "realtime_translate.xlsx",
          "description": "实时翻译写入的Excel文件名（位于工作区根目录）"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "dependencies": {
    "exceljs": "^4.3.0",
    "opencc-js": "^1.0.5"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "16.x",
    "@types/vscode": "^1.78.0",
    "@typescript-eslint/eslint-plugin": "^5.56.0",
    "@typescript-eslint/parser": "^5.56.0",
    "@vscode/test-electron": "^2.3.0",
    "eslint": "^8.36.0",
    "glob": "^8.1.0",
    "mocha": "^10.2.0",
    "ts-loader": "^9.4.2",
    "typescript": "^4.9.5",
    "webpack": "^5.76.3",
    "webpack-cli": "^5.0.1"
  }
}
